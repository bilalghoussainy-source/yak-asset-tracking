# Copy to .env.local for local development, then set the same in Vercel → Settings → Environment Variables
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_TABLE=asset_tracker

# Root (/) bootstrap admin — sign in with this username + ADMIN_PASSWORD without a Supabase user row
BOOTSTRAP_ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-strong-bootstrap-password

# Secret used for hashing app-user and portal passwords (do not change after go-live)
PORTAL_AUTH_SALT=use-a-long-random-secret-string
